  messages:
  - day: 1
    sender: "E\u015Fin"
    family: 1
    text: "Kira bu ak\u015Fam kesiliyor, unutma. Bir de deprem \xE7antas\u0131 i\u015Fini
      konu\u015Fal\u0131m; Elif okulda tatbikat yapm\u0131\u015F, \xE7ok korkmu\u015F."
    condition: 0
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 2
    sender: "E\u015Fin"
    family: 1
    text: "\xC7anta geldi, kap\u0131n\u0131n yan\u0131na koydum. Bir de Elif'in odas\u0131ndaki
      dolap \xE7ok uzun, \xF6\u011Fretmen duvara vidalay\u0131n demi\u015F."
    condition: 1
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 2
    sender: "E\u015Fin"
    family: 1
    text: "\xC7anta i\u015Fini konu\u015Fmad\u0131k, Elif yine sordu. Bir de odas\u0131ndaki
      dolap \xE7ok uzun, \xF6\u011Fretmen duvara vidalay\u0131n demi\u015F."
    condition: 2
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 3
    sender: "E\u015Fin"
    family: 1
    text: "Ne sars\u0131nt\u0131yd\u0131! Dolaplar sabit oldu\u011Fu i\xE7in kimseye
      bir \u015Fey olmad\u0131. Ama duvarlarda \xE7atlaklar var."
    condition: 1
    item: 1
    other: {fileID: 0}
    seal: 0
  - day: 3
    sender: "E\u015Fin"
    family: 1
    text: "Elif'in odas\u0131ndaki dolap \xFCst\xFCne devrildi, kolu incindi. Hastaneden
      yeni d\xF6nd\xFCk. Duvarlarda da \xE7atlaklar var."
    condition: 2
    item: 1
    other: {fileID: 0}
    seal: 0
  - day: 3
    sender: Elif
    family: 1
    text: "Baba \xE7antadaki fener \xE7ok i\u015Fe yarad\u0131, elektrikler gitti."
    condition: 1
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 3
    sender: Elif
    family: 1
    text: "Baba karanl\u0131kta \xE7ok korktum, evde fener bile yoktu."
    condition: 2
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 3
    sender: Ev sahibi
    family: 0
    text: "Bina depremde hasar ald\u0131. Dairenizin onar\u0131m\u0131 4.500 TL,
      telefondaki d\xFCkk\xE2ndan \xF6denebiliyor. \u0130kinci bir deprem olmadan
      yapt\u0131r\u0131n; d\xFCkk\xE2n 5. ak\u015Fam son kez a\xE7\u0131k."
    condition: 0
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 4
    sender: "E\u015Fin"
    family: 1
    text: "Usta onar\u0131ma 4.500 dedi. Yar\u0131n ak\u015Fama kadar yapt\u0131rmam\u0131z
      laz\u0131m."
    condition: 0
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 4
    sender: Bilinmeyen numara
    family: 0
    text: "Yak\u0131nda bir dosya gelecek. Yard\u0131mc\u0131 olursan\u0131z unutmam.
      -O"
    condition: 0
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 5
    sender: "E\u015Fin"
    family: 1
    text: "Onar\u0131m paras\u0131 yetiyor mu? D\xFCkk\xE2n bu ak\u015Fam son g\xFCn."
    condition: 0
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 5
    sender: Bilinmeyen numara
    family: 0
    text: "Te\u015Fekk\xFCrler. Kimse bir \u015Fey demez. -O"
    condition: 3
    item: 0
    other: {fileID: 11400000, guid: 9ac03a467c981484cb0d0e4e6f4b1b83, type: 2}
    seal: 1
  - day: 5
    sender: Bilinmeyen numara
    family: 0
    text: "Pi\u015Fman olacaks\u0131n. -O"
    condition: 3
    item: 0
    other: {fileID: 11400000, guid: 9ac03a467c981484cb0d0e4e6f4b1b83, type: 2}
    seal: 2
