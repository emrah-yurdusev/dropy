  m_Script: {fileID: 11500000, guid: 4f0ca156423bb7a4894d9dfff59afd1a, type: 3}
  m_Name: Story
  m_EditorClassIdentifier: 
  calls:
  - day: 1
    caller: "M\xFCd\xFCr (telefon)"
    lines:
    - "Alo? Hay\u0131rl\u0131 olsun, ilk g\xFCn\xFCn. K\u0131sa anlatay\u0131m, m\xFCteahhitler
      kap\u0131da."
    - "Gelen oturur, derdini anlat\u0131r. Lafa de\u011Fil k\xE2\u011F\u0131da bak:
      solda y\xF6netmelik, sa\u011Fda k\xFCnye ve ek rapor."
    - "K\xFCnyeye bir m\xFCh\xFCr basars\u0131n. Onay bin lira, red s\u0131f\u0131r.
      Perde ekle be\u015F y\xFCz, g\xFCnde bir kere."
    - "Kitapta yazmayan kusura tak\u0131lma. Ak\u015Fam kira kesilir. Kolay gelsin."
  - day: 4
    caller: "M\xFCd\xFCr (telefon)"
    lines:
    - "Alo, benim. \u0130yi misin, evdekiler iyi mi?"
    - "\u015Eehir hasar tespitiyle u\u011Fra\u015F\u0131yor. Bakanl\u0131k kitaba
      yeni madde ekledi: hasarl\u0131 binalar."
    - "Uzmanlar daha b\xFCy\xFCk bir deprem bekliyor. Onar\u0131m izinlerine dikkatli
      bak."
  - day: 6
    caller: "M\xFCd\xFCr (telefon)"
    lines:
    - "Alo, benim. Belediye kasas\u0131 bug\xFCn kapal\u0131, har\xE7 al\u0131nm\u0131yor."
    - "Yani bug\xFCn m\xFCh\xFCrler sana para getirmez. Ama binalar yine yap\u0131lacak,
      karar\u0131n yine ge\xE7erli."
    - Radyo da hep deprem diyor. Dikkatli bak.
  radio:
  - "Radyo: Uzmanlar b\xF6lgedeki fay hatt\u0131na dikkat \xE7ekiyor."
  - "Radyo: AFAD, deprem \xE7antas\u0131nda su, fener ve ilk yard\u0131m malzemesi
    bulunmas\u0131n\u0131 hat\u0131rlatt\u0131."
  - "Radyo: D\xFCn gece hafif bir sars\u0131nt\u0131 hissedildi. Uzmanlar dolaplar\u0131n
    duvara sabitlenmesini \xF6neriyor."
  - "Radyo: D\xFCnk\xFC depremin ard\u0131ndan hasar tespit \xE7al\u0131\u015Fmalar\u0131
    s\xFCr\xFCyor. Uzmanlar art\xE7\u0131lara kar\u015F\u0131 uyar\u0131yor."
  - "Radyo: Hasarl\u0131 binalara girilmemesi \xE7a\u011Fr\u0131s\u0131 yap\u0131ld\u0131.
    Uzmanlar daha b\xFCy\xFCk bir deprem olas\u0131l\u0131\u011F\u0131ndan s\xF6z
    ediyor."
  - "Radyo: Son iki g\xFCnde onlarca sars\u0131nt\u0131 kaydedildi. Vatanda\u015Flar
    tedirgin."
  tremors:
  - 0
  - 0.012
  - 0
  - 0
  - 0.025
  - 0
  messages:
  - day: 1
    sender: "E\u015Fin"
    family: 1
    text: "Kira bu ak\u015Fam kesiliyor, unutma. Bir de deprem \xE7antas\u0131 i\u015Fini
      konu\u015Fal\u0131m; Elif okulda tatbikat yapm\u0131\u015F, \xE7ok korkmu\u015F."
    condition: 0
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 2
    sender: "E\u015Fin"
    family: 1
    text: "\xC7anta geldi, kap\u0131n\u0131n yan\u0131na koydum. Bir de Elif'in odas\u0131ndaki
      dolap \xE7ok uzun, \xF6\u011Fretmen duvara vidalay\u0131n demi\u015F."
    condition: 1
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 2
    sender: "E\u015Fin"
    family: 1
    text: "\xC7anta i\u015Fini konu\u015Fmad\u0131k, Elif yine sordu. Bir de odas\u0131ndaki
      dolap \xE7ok uzun, \xF6\u011Fretmen duvara vidalay\u0131n demi\u015F."
    condition: 2
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 3
    sender: "E\u015Fin"
    family: 1
    text: "Ne sars\u0131nt\u0131yd\u0131! Dolaplar sabit oldu\u011Fu i\xE7in kimseye
      bir \u015Fey olmad\u0131. Ama duvarlarda \xE7atlaklar var."
    condition: 1
    item: 1
    other: {fileID: 0}
    seal: 0
  - day: 3
    sender: "E\u015Fin"
    family: 1
    text: "Elif'in odas\u0131ndaki dolap \xFCst\xFCne devrildi, kolu incindi. Hastaneden
      yeni d\xF6nd\xFCk. Duvarlarda da \xE7atlaklar var."
    condition: 2
    item: 1
    other: {fileID: 0}
    seal: 0
  - day: 3
    sender: Elif
    family: 1
    text: "Baba \xE7antadaki fener \xE7ok i\u015Fe yarad\u0131, elektrikler gitti."
    condition: 1
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 3
    sender: Elif
    family: 1
    text: "Baba karanl\u0131kta \xE7ok korktum, evde fener bile yoktu."
    condition: 2
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 3
    sender: Ev sahibi
    family: 0
    text: "Bina depremde hasar ald\u0131. Dairenizin onar\u0131m\u0131 4.500 TL,
      telefondaki d\xFCkk\xE2ndan \xF6denebiliyor. \u0130kinci bir deprem olmadan
      yapt\u0131r\u0131n; d\xFCkk\xE2n 5. ak\u015Fam son kez a\xE7\u0131k."
    condition: 0
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 4
    sender: "E\u015Fin"
    family: 1
    text: "Usta onar\u0131ma 4.500 dedi. Yar\u0131n ak\u015Fama kadar yapt\u0131rmam\u0131z
      laz\u0131m."
    condition: 0
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 4
    sender: Bilinmeyen numara
    family: 0
    text: "Yak\u0131nda bir dosya gelecek. Yard\u0131mc\u0131 olursan\u0131z unutmam.
      -O"
    condition: 0
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 5
    sender: "E\u015Fin"
    family: 1
    text: "Onar\u0131m paras\u0131 yetiyor mu? D\xFCkk\xE2n bu ak\u015Fam son g\xFCn."
    condition: 0
    item: 0
    other: {fileID: 0}
    seal: 0
  - day: 5
    sender: Bilinmeyen numara
    family: 0
    text: "Te\u015Fekk\xFCrler. Kimse bir \u015Fey demez. -O"
    condition: 3
    item: 0
    other: {fileID: 11400000, guid: 9ac03a467c981484cb0d0e4e6f4b1b83, type: 2}
    seal: 1
  - day: 5
    sender: Bilinmeyen numara
    family: 0
    text: "Pi\u015Fman olacaks\u0131n. -O"
    condition: 3
    item: 0
    other: {fileID: 11400000, guid: 9ac03a467c981484cb0d0e4e6f4b1b83, type: 2}
    seal: 2
  needs:
  - day: 1
    name: Elif'in okul gezisi
    price: 300
    sender: Elif
    request: "Baba yar\u0131n m\xFCzeye gezi var! 300 TL laz\u0131m, herkes gidiyor.
      Gidebilir miyim? L\xFCtfen l\xFCtfen!"
    paidReply: "Baba gezi \xE7ok g\xFCzeldi! M\xFCzede deprem sim\xFClat\xF6r\xFCne
      bindik."
    unpaidReply: "Herkes geziye gitti, ben s\u0131n\u0131fta kald\u0131m."
    endingPaid: "Elif okul gezisini h\xE2l\xE2 anlat\u0131yor."
    endingUnpaid: Elif okul gezisine gidemedi.
  - day: 2
    name: "Annenin ilac\u0131"
    price: 500
    sender: Annen
    request: "Evlad\u0131m ilac\u0131m bitti, eczane 500 TL istiyor. Maa\u015F yetmedi,
      utanarak yaz\u0131yorum."
    paidReply: "\u0130lac\u0131m geldi, Allah raz\u0131 olsun evlad\u0131m."
    unpaidReply: "\u0130lac\u0131 bu ay alamad\u0131m, idare ederim, sen dert etme."
    endingPaid: "Annenin ilac\u0131 aksamad\u0131."
    endingUnpaid: "Annenin ilac\u0131 bir hafta aksad\u0131."
  - day: 4
    name: Kombi tamiri
    price: 400
    sender: "E\u015Fin"
    request: "Depremde kombi bozuldu, tamiri 400 TL. Bu so\u011Fukta Elif hasta olur."
    paidReply: "Kombi yap\u0131ld\u0131, ev \u0131s\u0131nd\u0131."
    unpaidReply: "Kombi h\xE2l\xE2 bozuk. Elif'le battaniyeye sar\u0131nd\u0131k."
    endingPaid: "Ev hafta boyunca s\u0131cak kald\u0131."
    endingUnpaid: "Ev iki gece so\u011Fuk kald\u0131."
  - day: 5
    name: "Elif'in do\u011Fum g\xFCn\xFC pastas\u0131"
    price: 300
    sender: Elif
    request: "Baba yar\u0131n do\u011Fum g\xFCn\xFCm! Pasta olacak m\u0131? Arkada\u015Flar\u0131m\u0131
      \xE7a\u011F\u0131rd\u0131m."
    paidReply: 
    unpaidReply: 
    endingPaid: "Elif do\u011Fum g\xFCn\xFCnde mumlar\u0131n\u0131 \xFCfledi."
    endingUnpaid: "Elif'in do\u011Fum g\xFCn\xFC pastas\u0131z ge\xE7ti."
