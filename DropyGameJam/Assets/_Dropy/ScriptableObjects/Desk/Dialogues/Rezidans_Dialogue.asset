  m_Script: {fileID: 11500000, guid: ea03c079f1db36a42a78afdb91d3b8a9, type: 3}
  m_Name: Rezidans_Dialogue
  m_EditorClassIdentifier: 
  nodes:
  - id: start
    npcText: "Merhaba. Aksoy L\xFCks Rezidans. Sat\u0131\u015Flar ba\u015Flad\u0131,
      vizeyi bug\xFCn almam laz\u0131m."
    expression: 0
    choices:
    - text: "Belgelere bir bakal\u0131m."
      next: 
      evt: 3
    - text: Neden bu kadar acele?
      next: teklif
      evt: 0
    next: 
    evt: 0
  - id: teklif
    npcText: "Aram\u0131zda kals\u0131n hocam... \u0130\u015Fi h\u0131zland\u0131r\u0131rsan\u0131z
      5.000 liral\u0131k bir te\u015Fekk\xFCr\xFCm\xFCz olur. Sizin de bir eviniz,
      aileniz var sonu\xE7ta."
    expression: 4
    choices:
    - text: "Anla\u015Ft\u0131k. (R\xFC\u015Fveti kabul et)"
      next: kabul
      evt: 1
    - text: "R\xFC\u015Fvet mi teklif ediyorsunuz? Kesinlikle hay\u0131r."
      next: red
      evt: 2
    next: 
    evt: 0
  - id: kabul
    npcText: "Ak\u0131ll\u0131 adams\u0131n\u0131z hocam. Belgeler \xF6n\xFCn\xFCzde,
      bir damga yeter."
    expression: 5
    choices: []
    next: 
    evt: 3
  - id: red
    npcText: "Peki, nas\u0131l isterseniz... Buyurun belgeler."
    expression: 1
    choices: []
    next: 
    evt: 3
