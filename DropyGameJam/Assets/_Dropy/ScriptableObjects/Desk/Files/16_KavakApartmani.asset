  dialogue: {fileID: 0}
  callbacks: []
  introLines:
  - "Depremde s\u0131valar \xE7atlad\u0131, onar\u0131m izni i\xE7in geldim."
  - "On iki aile \xE7ad\u0131rda bekliyor. Altta market var, raflar\u0131 yeniden
    dizdik bile."
  questions:
  - question: "Market kat\u0131nda duvar var m\u0131?"
    answer: "Yok, ba\u015Ftan ba\u015Fa raf. Ama kolonlar sa\u011Flam, raporda yaz\u0131yor."
  - question: "Raporu kim haz\u0131rlad\u0131?"
    answer: "Belediyenin hasar ekibi, d\xFCn geldiler. \u0130mzal\u0131."
  approvedLine: "\xC7ad\u0131rdakiler eve d\xF6ner, sa\u011F olun."
  shearWallLine: "Perde mi? Marketi daralt\u0131r\u0131z, yeter ki aileler d\xF6ns\xFCn."
  rejectedLine: "Ama hasar hafif! On iki aile \xE7ad\u0131rda kalacak."
  rejectPressure: []
  collapseHeadline: "Kavak Apartman\u0131'n\u0131n market kat\u0131 \xE7\xF6kt\xFC"
  standingLine: "Kavak Apartman\u0131 ayakta: on iki aile evine d\xF6nd\xFC."
