  bodyFont: {fileID: 11400000, guid: 9fa5d6c3244ecbd49abbc675a40ea760, type: 2}
  texts:
    headlineAllStanding: "\u0130sk\xE2n verilen binalar\u0131n hepsi ayakta"
    headlineEmptyFallen: "{0} bina \xE7\xF6kt\xFC, hi\xE7birinde kimse yoktu"
    subheadAllStanding: "B\xFCronun m\xFCh\xFCr bast\u0131\u011F\u0131 her bina depremi
      ayakta kar\u015F\u0131lad\u0131. Onaylanan her bina, bir ailenin yuvas\u0131."
    subheadEmptyFallen: "\xC7\xF6ken binalar\u0131n hi\xE7birine isk\xE2n verilmemi\u015Fti;
      i\xE7lerinde kimse yoktu."
    photoCaption: "\u0130sk\xE2n memuru, b\xFCroda: \"Kitaba bakt\u0131m, o kadar.\""
    photoCaptionBribed: "Tefti\u015F Kurulu'nun incelemesi sonras\u0131 g\xF6revden
      uzakla\u015Ft\u0131r\u0131lan isk\xE2n memuru."
    jailHeadline: "\u0130sk\xE2n memuru g\xF6zalt\u0131na al\u0131nd\u0131"
    jailSubheadOne: "\xC7\xF6ken {0} binas\u0131n\u0131n isk\xE2n\u0131nda onun imzas\u0131
      vard\u0131; hakk\u0131nda soru\u015Fturma ba\u015Flat\u0131ld\u0131."
    jailSubheadMany: "\xC7\xF6ken {0} binan\u0131n isk\xE2n\u0131nda onun imzas\u0131
      vard\u0131; hakk\u0131nda soru\u015Fturma ba\u015Flat\u0131ld\u0131."
    jailEdition: "{0}. g\xFCn depreminden sonra"
    jailCaption: "G\xF6zalt\u0131na al\u0131nan isk\xE2n memuru ifade vermeye g\xF6t\xFCr\xFCld\xFC."
    courtText: "Y\xF6netmelikteki kural\u0131 \xE7i\u011Fneyen bina depremde \xE7\xF6kt\xFC.
      Aileler tatbikat sayesinde son anda d\u0131\u015Far\u0131 \xE7\u0131kt\u0131
      ama yuvalar\u0131n\u0131 kaybetti. Savc\u0131l\u0131k, m\xFCteahhitle birlikte
      isk\xE2n memuru hakk\u0131nda da soru\u015Fturma ba\u015Flatt\u0131."
    courtBribe: "Dosyada r\xFC\u015Fvet kayd\u0131 da var; Tefti\u015F Kurulu ayr\u0131ca
      inceliyor."
    jailFooterLeft: "OYUN B\u0130TT\u0130"
    jailFooterRight: "NEY\u0130 KA\xC7IRDI\u011EINI KARNEDE G\xD6R"
    boxHome: EVDE
    boxFamily: "A\u0130LEDEN"
    boxFellEmpty: "BO\u015E \xC7\xD6KENLER"
    boxStanding: AYAKTA KALANLAR
    boxEmptySound: "SA\u011ELAM AMA BO\u015E KALANLAR"
    boxCollapsed: "\xC7\xD6KENLER"
    boxInvestigation: "SORU\u015ETURMA"
    boxReward: "\xD6D\xDCL"
    rewardLine: "Kusursuz sicil: \u0130mar M\xFCd\xFCrl\xFC\u011F\xFC d\xFCr\xFCst
      memura {0} prim verdi. R\xFC\u015Fvet\xE7inin teklif etti\u011Fi para, hak
      edilerek kazan\u0131ld\u0131."
    boxCourt: "SORU\u015ETURMA"
    boxExperts: "UZMANLAR D\u0130YOR K\u0130"
    expertLines:
    - "M\xFChendisler: Zemin et\xFCd\xFC, do\u011Fru beton, sa\u011Flam kolon. Deprem
      g\xFCvenli\u011Fi k\xE2\u011F\u0131tta ba\u015Flar."
    - "M\xFCteahhitler: Fayk\xF6y'\xFCn ustalar\u0131n\u0131n \xE7o\u011Fu i\u015Fini
      kurala g\xF6re yapar; denetim d\xFCr\xFCst i\u015Fi korur."
    emptySoundNote: "\u0130sk\xE2n verilmedi; aileleri h\xE2l\xE2 kirada."
    investigation: "Tefti\u015F Kurulu, {0} dosyas\u0131ndaki r\xFC\u015Fvet kayd\u0131n\u0131
      inceledi: paraya el konuldu. G\xF6revden uzakla\u015Ft\u0131r\u0131ld\u0131n,
      soru\u015Fturma s\xFCr\xFCyor."
    contractorQuote: "M\xFCteahhit {0}, isk\xE2n g\xFCn\xFC: \"{1}\""
    bagReady: "\xC7anta haz\u0131rd\u0131: fener, su, d\xFCd\xFCk."
    bagNone: "Karanl\u0131kta ne su vard\u0131 ne fener."
    fixingDone: "Dolaplar sabitti; depremde kimse yaralanmad\u0131."
    fixingMissing: "Sabitlenmemi\u015F dolap devrildi; Elif son anda kenara ka\xE7t\u0131,
      \xE7ok korktu."
    verdictSafe: "A\u0130LEN G\xDCVENDE"
    verdictNoBag: "Herkes iyi; ama gece karanl\u0131kta ve susuz ge\xE7ti."
    verdictNoFixing: "Devrilen dolap Elif'i \xE7ok korkuttu; \xE7antadaki fener ve
      d\xFCd\xFCk sayesinde yard\u0131m \xE7abuk geldi."
    verdictNone: "Dolap devrildi, ev karanl\u0131kt\u0131; Elif \xE7ok korktu, yard\u0131m
      ancak sabaha kar\u015F\u0131 geldi."
    estrangedHouse: "Ailen sana biraz k\xFCs."
    repairDone: "Sars\u0131nt\u0131da \xE7atlayan ev g\xFC\xE7lendirildi; depremde
      ayakta kald\u0131."
    repairNone: "Sars\u0131nt\u0131da \xE7atlayan ev g\xFC\xE7lendirilmedi; depremde
      y\u0131k\u0131ld\u0131."
    verdictHomeLostSafe: "EV\u0130N YIKILDI, A\u0130LEN G\xDCVENDE"
    verdictHomeLostNoBag: "Ev y\u0131k\u0131ld\u0131 ama aile d\u0131\u015Far\u0131
      \xE7\u0131kt\u0131. Dolaplar sabitti; yaln\u0131z fener yoktu, gece karanl\u0131kta
      ge\xE7ti."
    verdictHomeLostNoFixing: "Ev y\u0131k\u0131ld\u0131 ama aile \xE7antay\u0131
      kap\u0131p \xE7\u0131kt\u0131. Devrilen dolap Elif'i \xE7ok korkuttu."
    verdictHomeLostNone: "Ev y\u0131k\u0131ld\u0131. Allahtan evde kimse yoktu; ama
      hi\xE7bir haz\u0131rl\u0131k olmad\u0131\u011F\u0131 i\xE7in b\xFCt\xFCn e\u015Fyalar
      y\u0131k\u0131nt\u0131da kald\u0131."
    homeStorySurvived: "Y\u0131k\u0131lan evden hemen \xE7\u0131kt\u0131lar: \xE7anta
      kap\u0131n\u0131n yan\u0131ndayd\u0131, aile toplanma alan\u0131nda bulu\u015Ftu."
    homeStoryInjured: "\u0130sk\xE2n memurunun evi y\u0131k\u0131ld\u0131; aile d\u0131\u015Far\u0131
      \xE7\u0131kt\u0131 ama gece zor ge\xE7ti."
    headlineFamilyLost: "\u0130sk\xE2n memurunun evi y\u0131k\u0131ld\u0131; Allahtan
      evde kimse yoktu"
    subheadFamilyLost: "Sars\u0131nt\u0131da \xE7atlayan ev g\xFC\xE7lendirilmemi\u015Fti;
      evde ne sabitlenmi\u015F dolap vard\u0131 ne deprem \xE7antas\u0131."
    homeStoryLost: "\u0130sk\xE2n memurunun ailesi o gece akrabadayd\u0131. Ev y\u0131k\u0131ld\u0131;
      haz\u0131rl\u0131k olmad\u0131\u011F\u0131 i\xE7in hi\xE7bir e\u015Fya kurtar\u0131lamad\u0131."
    footerReport: "KARNE: {1} DOSYADAN {0} DO\u011ERU"
    footerCash: 'KASA: {0}'
    footerDebt: "BOR\xC7: {0}"
